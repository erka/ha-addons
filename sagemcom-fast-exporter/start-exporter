#!/usr/bin/with-contenv bashio
set -e

ARGS="--bind=$(bashio::config 'addr') --username=$(bashio::config 'username') --password=$(bashio::config 'password') --host=$(bashio::config 'host') --auth-method=$(bashio::config 'authMethod') --log-level=$(bashio::config 'logLevel') --refresh-interval=$(bashio::config 'refresh')"

bashio::log.info "Starting"

if ! "/sagemcom-fast-exporter" $ARGS
then
    bashio::log.error "Error starting"
fi
